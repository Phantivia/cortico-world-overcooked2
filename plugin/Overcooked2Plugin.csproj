<Project Sdk="Microsoft.NET.Sdk">
  <!-- BepInEx 5 plugin for the Unity 2017.4 Mono build (.NET 3.5 profile). The build compiles
       against the game's own mscorlib/System and BepInEx from GameDir; nothing from the game or
       BepInEx is copied into this repository. -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>CorticoOvercooked2</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">L:\SteamLibrary\steamapps\common\Overcooked! 2</GameDir>
    <Managed>$(GameDir)\Overcooked2_Data\Managed</Managed>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <FrameworkPathOverride>$(Managed)</FrameworkPathOverride>
    <NoWarn>$(NoWarn);MSB3270;MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(Managed)\mscorlib.dll" Private="false" />
    <Reference Include="$(Managed)\System.dll" Private="false" />
    <Reference Include="$(Managed)\System.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Managed)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.JSONSerializeModule.dll" Private="false" />
  </ItemGroup>
</Project>
